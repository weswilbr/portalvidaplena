// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?  @unique
  password           String
  mustChangePassword Boolean  @default(false)
  role               String   @default("SELLER") // ADMIN, SELLER
  leads              Lead[]   @relation("UserLeads")
  messages           Message[] @relation("UserMessages")
  quickReplies       QuickReply[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  source      String?  // WhatsApp, Instagram, Landing Page
  status      String   @default("NEW") // NEW, CONTACTED, PRESENTED, CLOSED, LOST
  interest    String?  // Produto, Negócio
  notes       String?
  profilePic  String?  // URL da foto de perfil do WhatsApp
  assignedToId String?
  assignedTo   User?    @relation("UserLeads", fields: [assignedToId], references: [id])
  unreadCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  content     String
  authorId    String?
  author      User?    @relation("UserMessages", fields: [authorId], references: [id], onDelete: SetNull)
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  isSystem    Boolean  @default(false)
  isNote      Boolean  @default(false) // true = nota interna CRM, false = mensagem WhatsApp
  mediaUrl      String?  // URL do anexo (upload ou link WhatsApp)
  mediaType     String?  // image, video, document, audio
  transcription String?  // Texto transcrito de áudio (AI)
  createdAt     DateTime @default(now())
}

model QuickReply {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  userId    String?  // null = global, string = específico do usuário
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model OutgoingMessage {
  id        String   @id @default(cuid())
  to        String
  body      String
  mediaUrl  String?
  mediaType String?
  fileName  String?
  status    String   @default("PENDING") // PENDING, SENT, FAILED
  errorMsg  String?
  leadId    String?
  authorId  String?
  createdAt DateTime @default(now())
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  id4Life     String?  // ID de cadastro na 4Life
  level       String?  // Associate, Builder, Diamond, etc.
  lpMonthly   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Goal {
  id          String   @id @default(cuid())
  title       String   @default("Ouro Elite")
  targetLP    Int
  targetSignups Int
  currentLP   Int      @default(0)
  currentSignups Int   @default(0)
  deadline    DateTime?
  createdAt   DateTime @default(now())
}

model AgendaItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  start       DateTime
  end         DateTime?
  allDay      Boolean  @default(false)
  status      String   @default("PENDING") // PENDING, DONE, CANCELLED
  category    String?  // Prospecção, Reunião, Treinamento, Gestão
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Metric {
  id          String   @id @default(cuid())
  date        DateTime @unique @default(now())
  leadsCaught Int      @default(0)
  presentations Int    @default(0)
  signups     Int      @default(0)
  lpGenerated Int      @default(0)
}

model BotConfig {
  id              String   @id @default(cuid())
  status          String   @default("DISCONNECTED") // DISCONNECTED, CONNECTING, CONNECTED, QR_READY
  qrCode          String?  @db.Text
  welcomeMessage  String?  @db.Text
  transferMessage String?  @db.Text
  isRoundRobin    Boolean  @default(true) // Se ativo, distribui leads automaticamente; se falso, envia para a fila geral
  updatedAt       DateTime @updatedAt
}
